# ============================================================
# 环境变量配置示例
# 用法：复制本文件为 .env，然后填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交到版本库
# ============================================================

# ---------- LLM（阿里云 DashScope / Qwen） ----------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=kimi-k3

# ---------- 高德地图 API ----------
AMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=suse_agent

# ---------- Neo4j ----------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- 邮件发送（登录验证码 SMTP） ----------
SMTP_SENDER=your-email@example.com
# QQ 邮箱 SMTP 授权码
SMTP_PASSWORD=your_smtp_auth_code
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587

# ---------- MCP 服务 ----------
MCP_SERVER_URL=http://localhost:9000/mcp

# ---------- 应用服务 ----------
APP_HOST=localhost
APP_PORT=8000
# 多个来源用英文逗号分隔，如 http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:8080

# ---------- Langfuse 全链路追踪 ----------
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
